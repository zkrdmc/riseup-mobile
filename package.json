{
  "name": "riseup-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "smoke": "node -e \"require('fs').rmSync('.smoke',{recursive:true,force:true})\" && tsc --ignoreConfig src/capture/survey/schema.ts src/capture/survey/derive.ts src/capture/survey/distortion.ts src/capture/survey/opencv.ts src/capture/survey/exif.ts src/capture/survey/validate.ts src/capture/framing/landmarks.ts src/capture/framing/visibility.ts src/capture/framing/detector.ts src/capture/framing/pair.ts src/capture/upload/chunkManifest.ts src/capture/devices/merge.ts src/i18n/dictionaries.ts src/i18n/i18n.ts --rootDir src --outDir .smoke --module commonjs --target es2020 --skipLibCheck --esModuleInterop && node src/capture/survey/__tests__/smoke.js"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.5",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.102.8",
    "eas": "^0.1.0",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.3",
    "expo-updates": "~57.0.21",
    "expo-video-thumbnails": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@clerk/expo"
      ]
    }
  }
}
