# ─────────────────────────────────────────────────────────────────────────────
# RiseUp Mobile — environment
#
# Copy to `.env` and fill in. Metro INLINES these at build time, so after any
# change restart with `npx expo start --clear` — a fast refresh will not pick
# them up, and the resulting "why is it still hitting the old host" is a
# 20-minute detour every single time.
#
# Nothing secret belongs here. A Clerk publishable key and an API host are
# both public by design; anything that is not public has no business on a
# device (PRD §11).
# ─────────────────────────────────────────────────────────────────────────────

# The API. In development this must be a LAN address, not localhost — a phone
# resolving `localhost` resolves itself. Find yours with `ipconfig`.
#   production:  https://api.riseupai.co
#   development: http://192.168.1.42:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Clerk publishable key. Same instance the dashboard uses, so a coach's
# existing account works on the phone with no migration.
# Dashboard → API Keys. The test instance is prompt-moose-74.clerk.accounts.dev.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
